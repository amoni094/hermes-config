# Hermes .env — template with redacted values
# Copy this file to ~/.hermes/.env and fill in your own keys.

# === Anthropic (primary provider) ===
ANTHROPIC_API_KEY=<your_anthropic_key>

# === Free tier providers ===

# Groq: 1,000 RPD, 30 RPM, ~320 tok/s — https://console.groq.com/
# Note: blocked from datacenter/VPN IPs; use split-tunnel or residential IP to sign up
# GROQ_API_KEY=<your_groq_key>

# Cerebras: 14,400 RPD — https://cloud.cerebras.ai/
# Free tier caps context at 8K tokens (128K is paid only)
# CEREBRAS_API_KEY=<your_cerebras_key>

# SambaNova: 20 RPD/model, no data training — https://cloud.sambanova.ai/
# SAMBANOVA_API_KEY=<your_sambanova_key>

# Mistral: ~1B tokens/month (Experiment plan, data training opt-in) — https://console.mistral.ai/
# MISTRAL_API_KEY=<your_mistral_key>

# Google Gemini: 1,500 RPD (Flash), 1M ctx — https://aistudio.google.com/app/apikey
# Note: prompts used for training outside EU/UK/EEA/CH
# GOOGLE_API_KEY=<your_google_ai_studio_key>
# GEMINI_API_KEY=<your_google_ai_studio_key>

# GitHub Models: 150-1000 RPD, free GPT-4o/Llama 405B — https://github.com/settings/tokens
# Classic PAT, no scopes needed for GitHub Models
# GITHUB_TOKEN=<your_github_pat>

# OpenRouter: 50 RPD free (1000/day with $10 topup) — https://openrouter.ai/keys
# OPENROUTER_API_KEY=<your_openrouter_key>

# === Local Ollama (always available, no quota) ===
# Installed models: qwen3:8b, llama3.2:3b
# No key needed — served at http://localhost:11434
